@article{conyersMoralPanicAdministrative2025,
	title = {Moral panic: An administrative tool of fear and marginalization},
	volume = {47},
	issn = {1084-1806},
	url = {https://doi.org/10.1080/10841806.2025.2488688},
	doi = {10.1080/10841806.2025.2488688},
	shorttitle = {Moral panic},
	abstract = {Moral panic theory is an effective framework for analyzing how societal fears and anxieties can transform administrative ideologies into concrete practices and policies. Moral panics allow governmental bodies to cultivate an image of protective guardians, effectively increasing their regulatory influence while concurrently disenfranchising marginalized identities. This article examines how the Trump administration uses moral panics as a political tool to shape policy and administrative action. Through moral panics, the Trump administration’s “Make America Great Again” moral crusade uses government power, institutions, and policies to systematically target and marginalize certain populations.},
	pages = {168--176},
	number = {2},
	journaltitle = {Administrative Theory \& Praxis},
